{
  "buildCommand": "cd DATEL-CARE && npm run build",
  "installCommand": "cd DATEL-CARE && npm install",
  "outputDirectory": "DATEL-CARE/.next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/licenses/validate",
      "destination": "/api/licenses/validate"
    },
    {
      "source": "/api/licenses/:path*",
      "destination": "https://hudi-hospital.onrender.com/api/licenses/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://hudi-hospital.onrender.com/api/:path*"
    }
  ]
}
