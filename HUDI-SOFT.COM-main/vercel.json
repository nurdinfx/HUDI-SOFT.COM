{
  "version": 2,
  "builds": [
    {
      "src": "HUDI-SOFT-HMS-main/package.json",
      "use": "@vercel/next"
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/HUDI-SOFT-HMS-main/$1" }
  ],
  "functions": {
    "HUDI-SOFT-HMS-main/app/api/**/*.{js,ts}": {
      "runtime": "@vercel/node"
    }
  }
}
