# Hospital Management API (SQLite backend on Render or local)
NEXT_PUBLIC_API_URL=https://hudi-soft-hms.onrender.com

# Central license validation (HUDI SOFT licensing — MongoDB)
# On Vercel, leave unset to use same-origin /license-api proxy (see vercel.json).
# Web (Vercel): leave unset — uses same-origin /api/licenses/validate (no CORS).
# Capacitor / native only:
# NEXT_PUBLIC_LICENSE_API_URL=https://hudi-soft-com.onrender.com/api
# NEVER use hudi-hospital.onrender.com (service retired).

# Optional: local development
# NEXT_PUBLIC_API_URL=http://10.0.2.2:4000
