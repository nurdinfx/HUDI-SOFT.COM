{
  "name": "datel-clinic-backend",
  "version": "1.0.0",
  "description": "Datel Clinic System — Backend API (Node.js + Express + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/db/migrate.js && node src/server.js",
    "dev": "nodemon src/server.js",
