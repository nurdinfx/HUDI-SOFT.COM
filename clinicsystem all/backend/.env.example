# Server
PORT=6000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/datel_clinic_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datel_clinic_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=30d

# HUDI-SOFT Central Licensing API
HUDI_SOFT_API_URL=https://hudi-soft-com.onrender.com/api

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads

# Render (production keep-alive)
RENDER_EXTERNAL_URL=https://datel-clinic-api.onrender.com
